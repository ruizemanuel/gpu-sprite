{
  "name": "gpu-sprite",
  "version": "0.0.1",
  "description": "Tiny learned 16x16 1-bit sprite generator for the browser, on CPU or WebGPU",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "tsc -p tsconfig.json && node scripts/bundle.ts",
    "size": "node scripts/size.ts",
    "test:browser": "node test/browser/parity.ts"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.25.12",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
