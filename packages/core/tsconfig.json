{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@webgpu/types"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
